{
  "name": "web-app-template",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "app",
  "runServices": [
    "db",
    "redis",
    "mailpit",
    "grafana",
    "umami-db-init",
    "umami",
    "umami-seed",
    "bull-board",
    "redisinsight",
    "drizzle-gateway",
    "app"
  ],
  "workspaceFolder": "/workspace",
  "overrideCommand": true,
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000, 5173, 5432, 3001, 3002, 3003, 4983, 5540, 8025],
  "portsAttributes": {
    "3000": { "label": "API" },
    "5173": { "label": "Vite" },
    "5432": { "label": "Postgres" },
    "3001": { "label": "Grafana" },
    "3002": { "label": "Umami" },
    "3003": { "label": "Bull Board" },
    "4983": { "label": "Drizzle Gateway" },
    "5540": { "label": "RedisInsight" },
    "8025": { "label": "Mailpit" }
  },
  "postCreateCommand": "pnpm install --frozen-lockfile && pnpm exec playwright install --with-deps chromium",
  "postStartCommand": "pnpm db:migrate",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "vitest.explorer",
        "ms-playwright.playwright",
        "ms-azuretools.vscode-docker",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit",
          "source.organizeImports.biome": "explicit"
        }
      }
    }
  }
}
