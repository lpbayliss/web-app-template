{
  "uid": "web-app-template-worker",
  "title": "web-app-template / Worker",
  "description": "BullMQ job throughput, failures and duration, email delivery and runtime health of the worker process: Prometheus job web-app-template-worker (GET /metrics on WORKER_PORT) and Loki service_name=web-app-template-worker.",
  "tags": ["web-app-template"],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "web-app-template dashboards",
      "type": "dashboards",
      "tags": ["web-app-template"],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"web-app-template-worker\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"web-app-template-worker\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "service",
        "label": "Log service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service_name",
          "refId": "service",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(service_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "web-app-template-worker",
          "value": "web-app-template-worker"
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": null,
      "options": {
        "mode": "markdown",
        "content": "**Scope.** Everything here comes from the worker process: Prometheus job `web-app-template-worker` (its `/metrics` on `WORKER_PORT`, 3010 by default) and Loki `service_name=web-app-template-worker`. `pnpm dev` runs the worker as its own process; with `JOBS_INLINE=true` the jobs run inside the web process instead and show up on the App dashboard under job `web-app-template`. Queue depth lives in Bull Board (http://localhost:3003)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jobs processed / s",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jobs_processed_total{job=\"web-app-template-worker\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Jobs processed / s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 3,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "orientation": "auto"
      }
    },
