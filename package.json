{
  "name": "web-app-template",
  "version": "0.0.0",
  "private": true,
  "description": "Production-grade full-stack TypeScript template: Hono + tRPC + React + Drizzle + Better Auth",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "imports": {
    "#core": "./src/server/core/index.ts",
    "#server/*": "./src/server/*",
    "#client/*": "./src/client/*",
    "#shared/*": "./src/shared/*",
    "#test/*": "./src/test/*"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --import @opentelemetry/auto-instrumentations-node/register --watch src/server/main.ts",
    "dev:client": "vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsdown",
    "start": "node --env-file-if-exists=.env --import @opentelemetry/auto-instrumentations-node/register dist/server/main.js",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node --env-file-if-exists=.env --import tsx src/server/db/reset.ts",
    "i18n:extract": "formatjs extract \"src/client/**/*.{ts,tsx}\" --out-file src/client/i18n/en.messages.json --format simple",
    "knip": "knip",
    "audit": "pnpm audit --prod --audit-level=high",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "prepare": "lefthook install",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --import @opentelemetry/auto-instrumentations-node/register --watch src/server/worker.main.ts",
    "start:worker": "node --env-file-if-exists=.env --import @opentelemetry/auto-instrumentations-node/register dist/server/worker.js",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/server/db/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@bull-board/api": "^9.6.0",
    "@bull-board/hono": "^9.6.0",
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "^0.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-winston": "^0.65.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prometheus-io/client": "^0.16.1",
    "@react-email/render": "^2.1.0",
    "@scalar/hono-api-reference": "^0.12.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "better-auth": "^1.7.2",
    "bullmq": "^6.3.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^6.0.0",
    "motion": "^13.1.1",
    "nodemailer": "^9.1.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-intl": "^10.1.25",
    "resend": "^6.25.0",
    "trpc-to-openapi": "^3.3.0",
    "winston": "^3.19.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@electric-sql/pglite": "^0.5.8",
    "@faker-js/faker": "^10.6.0",
    "@formatjs/cli": "^6.16.22",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "msw": "^2.15.0",
    "react-email": "^6.9.3",
    "semantic-release": "^25.0.9",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
