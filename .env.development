# Development defaults, committed. Every value matches the `docker compose up -d` stack, so `pnpm dev`
# works with no further setup. Load order in the dev scripts (package.json): this file, then `.env`
# (git-ignored, optional, overrides anything here), then the shell environment (overrides both).
# Production loads only `.env` (see `pnpm start` and the Dockerfile).
# Every variable is validated by src/server/core/config.ts at boot; see that file for defaults.
#
# Dev tool UIs, all started by `docker compose up -d` (more in README "What's running"):
#   App             http://localhost:5173
#   API docs        http://localhost:3000/api/docs
#   Grafana         http://localhost:3001   logs, traces, metrics (anonymous admin)
#   Umami           http://localhost:3002   analytics, admin / umami
#   Bull Board      http://localhost:3003   queues
#   RedisInsight    http://localhost:5540   cache and queue keys
#   Drizzle Gateway http://localhost:4983   database; add postgres://app:app@db:5432/app once
#   Mailpit         http://localhost:8025   sent emails

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Public origin of the app (auth callbacks, CORS, CSRF). In dev this is the Vite port.
APP_URL=http://localhost:5173

# docker compose up -d (db, redis and mailpit are the minimum the app itself needs)
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# >= 32 chars; override in .env for anything shared. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-change-me-change-me-change-me

# Users signing up with these emails get the admin role.
ADMIN_EMAILS=admin@example.com

# Optional bearer token protecting GET /metrics (>= 16 chars). Empty = unauthenticated (keep it internal!).
METRICS_TOKEN=

# Rate limit for /api/auth/* (requests per window)
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=60000

# Redis-backed response cache. Opt out globally here, or per procedure in code.
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_S=60

# true = run queue workers inside the web process (default outside production).
JOBS_INLINE=true

# Email: smtp (Mailpit locally: UI http://localhost:8025, API http://localhost:8025/api/v1) or resend.
EMAIL_FROM=App <no-reply@example.com>
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# Behind a reverse proxy / load balancer? Then trust X-Forwarded-* headers for client IPs.
TRUST_PROXY=false

# OpenTelemetry (preloaded by src/server/instrumentation.ts in the start scripts; no code changes needed).
# Traces and logs go to the Grafana LGTM container (docker compose up -d): UI http://localhost:3001.
# Metrics are scraped from GET /metrics by the same container, so the OTLP metrics exporter stays off.
# Set OTEL_SDK_DISABLED=true to run without it.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=web-app-template
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=otlp
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process

# Product analytics (Umami). Both must be set to enable; the client and server send events to it.
# Dev: the umami container at http://localhost:3002 (admin / umami); the website below is seeded on `docker compose up`.
# ANALYTICS_SERVER_URL is optional: where the server posts when the public URL is not reachable from it.
ANALYTICS_URL=http://localhost:3002
ANALYTICS_WEBSITE_ID=6ef283e9-def7-423a-9a9a-5682722e1daf
ANALYTICS_SERVER_URL=
# Running only db/redis/mailpit? Leave these empty or expect one "analytics event failed" warning per event.
# Umami's dev container runs with DISABLE_BOT_CHECK so server-side events (non-browser User-Agent) are accepted; do not do that on a shared instance.
