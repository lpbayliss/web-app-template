# Loaded by vitest.config.ts and playwright.config.ts. Safe to commit: no real secrets.
# Unit tests never open network connections (PGlite + in-memory cache). Integration and
# E2E tests use `docker compose --profile test up -d` (db-test, redis-test, mailpit-test).
NODE_ENV=test
PORT=3100
HOST=127.0.0.1
LOG_LEVEL=warn
LOG_FORMAT=pretty
APP_URL=http://127.0.0.1:3100
DATABASE_URL=postgres://app:app@localhost:5433/app_test
REDIS_URL=redis://localhost:6380
AUTH_SECRET=test-secret-test-secret-test-secret-test-secret
ADMIN_EMAILS=admin@example.com
METRICS_TOKEN=
RATE_LIMIT_AUTH_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=60000
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_S=60
JOBS_INLINE=true
EMAIL_FROM=Test <no-reply@example.test>
SMTP_URL=smtp://localhost:1026
MAILPIT_API_URL=http://localhost:8026
OTEL_SDK_DISABLED=true
